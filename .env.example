# Authentication settings (set AUTH_ENABLED=false for local dev)
AUTH_ENABLED=true
OIDC_URL=https://auth.internal.net
OIDC_REALM=network-operations
OIDC_CLIENT_ID=mcp-cisco-server
OIDC_CLIENT_SECRET=your_oidc_client_secret

# Router store configuration
# Options: static, file, env
ROUTER_STORE_TYPE=static

# For static store: JSON string with router inventory
ROUTER_INVENTORY_JSON='{"rtr-core-01": {"host": "10.0.1.1", "username": "admin", "password": "secret123"}, "rtr-edge-01": {"host": "10.0.2.1", "username": "netops", "password": "password456"}}'

# For file store: path to router inventory JSON file
# ROUTER_STORE_CONFIG={"filepath": "./router_inventory.json"}

# For env store: environment variable prefix
# ROUTER_STORE_CONFIG={"prefix": "ROUTER_"}

# Server settings
BASE_URL=http://localhost:8000
UNAUTHENTICATED_ROLE=network-admin
